# ─────────────────────────────────────────────────────────────
# Musabe Schools Management System — example configuration
# Copy to .env and edit. Never commit the real .env file.
# ─────────────────────────────────────────────────────────────

APP_NAME=Musabe Schools Management System
ENVIRONMENT=development
DEBUG=true

# PostgreSQL connection (assembled into DATABASE_URL automatically).
POSTGRES_USER=musabe
POSTGRES_PASSWORD=change-me
POSTGRES_DB=musabe
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Optional explicit override; leave blank to use the POSTGRES_* values above.
DATABASE_URL=

DATABASE_ECHO=false

# Generate a strong secret for production, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Comma-separated allowed web origins. Use explicit domains in production
# (e.g. https://musabe.example). "*" is for local development only.
CORS_ORIGINS=*
