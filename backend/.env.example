# Copy this file to .env and fill in your own values.
PORT=4310

# Database (PostgreSQL). Two accounts, see docs/database-roles.md. No real passwords in this file.
DATABASE_NAME=musabe_db
DATABASE_HOST=localhost
DATABASE_PORT=5432
# Runtime account used by the running app: restricted (read/write rows only, cannot change tables).
# In production this must NOT be "postgres": the app refuses to start as a superuser or table owner.
DATABASE_USER=musabe_app
DATABASE_PASSWORD=
# Migration account used only by "npm run migrate / seed / setup": owns the tables.
# Leave both empty to use the runtime account for migrations too (old single-account local setup).
MIGRATION_DATABASE_USER=musabe_owner
MIGRATION_DATABASE_PASSWORD=
# (Instead of the values above you may give full URLs: DATABASE_URL and MIGRATION_DATABASE_URL.)

# Client IP: which proxy may report the real client address (X-Forwarded-For). See src/lib/proxy.js.
# Empty = loopback (Nginx on the same server). Another machine: its IP, e.g. 10.0.0.5. No proxy: false.
# Never "true" or a number.
TRUST_PROXY=

# First Super Admin (created by "npm run seed" only if missing).
# SUPERADMIN_PASSWORD has NO default. Choose a private one (12+ characters, letters and numbers,
# not containing "musabe" or "admin"). Never put it in Git or in documents.
# It is needed only the first time; remove it from .env after the first sign-in.
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_NAME=System Administrator
SUPERADMIN_PASSWORD=

NODE_ENV=development
