# Copy this file to .env and fill in your own values.
PORT=4310

# Database (PostgreSQL). Two accounts, see docs/database-roles.md. No real passwords in this file.
DATABASE_NAME=musabe_db
DATABASE_HOST=localhost
DATABASE_PORT=5432
# Runtime account used by the running app: restricted (read/write rows only, cannot change tables).
# In production this must NOT be "postgres": the app refuses to start as a superuser or table owner.
DATABASE_USER=musabe_app
DATABASE_PASSWORD=
# Migration account used only by "npm run migrate / seed / setup": owns the tables.
# Leave both empty to use the runtime account for migrations too (old single-account local setup).
MIGRATION_DATABASE_USER=musabe_owner
MIGRATION_DATABASE_PASSWORD=
# (Instead of the values above you may give full URLs: DATABASE_URL and MIGRATION_DATABASE_URL.)

# Client IP: which proxy may report the real client address (X-Forwarded-For). See src/lib/proxy.js.
# Empty = loopback (Nginx on the same server). Another machine: its IP, e.g. 10.0.0.5. No proxy: false.
# Never "true" or a number.
TRUST_PROXY=

# First Super Admin (created by "npm run seed" only if missing).
# SUPERADMIN_PASSWORD has NO default. Choose a private one (12+ characters, letters and numbers,
# not containing "musabe" or "admin"). Never put it in Git or in documents.
# It is needed only the first time; remove it from .env after the first sign-in.
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_NAME=System Administrator
SUPERADMIN_PASSWORD=

NODE_ENV=development

# ---- Production safety (2026-11-14, see src/lib/guard.js and docs/deployment.md) ----
# The https address people open. Required in production; changes from any other website are refused.
APP_ORIGIN=
# Locally over http keep this false; production (NODE_ENV=production) always uses Secure cookies.
COOKIE_SECURE=false
# Database on another machine: encrypt the connection.
DATABASE_SSL=false
# DATABASE_SSL_CA=/etc/ssl/certs/db-ca.pem
# Optional tuning (defaults shown)
# SESSION_IDLE_MINUTES=120
# TEMP_PASSWORD_HOURS=72
# API_RATE_LIMIT=600
# UPLOAD_RATE_LIMIT=20
# BILL_DAYS=7
# RECEIPT_LATE_HOURS=24
# DELIVERY_LATE_HOURS=48
# DAMAGE_LATE_HOURS=48
# REQUEST_LATE_HOURS=48


# Signing (seals on signed papers). SEAL_SECRET: a long random text, set once and never changed (changing it breaks every old seal).
# SIGN_SMS_FROM: from this amount (TSh) an SMS code is also needed to sign. Default 1000000.
SEAL_SECRET=
SIGN_SMS_FROM=1000000

# Help chat (button on every account). It only explains how to use the pages of that account; it gets no data.
# Get a key at console.anthropic.com. Without a key the button says "not set up yet".
ANTHROPIC_API_KEY=
# HELP_MODEL=claude-haiku-5-5
# HELP_PER_HOUR=40
