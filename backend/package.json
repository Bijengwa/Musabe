{
  "name": "musabe-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Musabe Schools System API",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
